# Innovatech PH — AI Campus Navigation (Thesis 1)
# Copy this file to .env and fill real values. .env is git-ignored and web-blocked.
# Every value here is read by includes/config.php at boot.
#
# ONLINE HOSTING (Hostinger):
#   TITLE 1 and TITLE 2 each keep their OWN .env inside their own folder.
#   Use the SAME DB_USER / DB_PASS (same Hostinger MySQL user). Only DB_NAME
#   differs per thesis:
#     TITLE 1 -> DB_NAME=u467106394_thesis   (your existing hosting DB)
#     TITLE 2 -> DB_NAME=u467106394_thesis2  (create this in hPanel, same user)
#   Set DB_HOST to the Hostinger MySQL host (often localhost) and your real DB_PASS.

# Public base URL override (leave empty to auto-derive from the request).
# On hosting, set to your deployed URL, e.g. APP_URL=https://yoursite.com/TITLE1
APP_URL=

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=innovatech_campus
DB_USER=root
DB_PASS=